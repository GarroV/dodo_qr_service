# Пример окружения. Скопировать в .env и заполнить значения.
# В git попадает только этот файл — .env в .gitignore, значений в документах нет.

# ── Приложение ───────────────────────────────────────────────
# Порт приложения: http://localhost:3100
PORT=3100

# ── База ─────────────────────────────────────────────────────
# Подключение к PostgreSQL из docker-compose.yml
DATABASE_URL=postgres://dodo:dodo@localhost:5433/dodo_qr
# Эти три читает сам docker-compose.yml при подъёме контейнера
POSTGRES_USER=dodo
POSTGRES_PASSWORD=dodo
POSTGRES_DB=dodo_qr
# Порт базы на хосте
DB_PORT=5433
# База для прогона тестов: создаётся сама и пересоздаётся миграциями на каждом прогоне.
# Отдельная от рабочей, чтобы тесты не сносили данные разработчика.
# Если не задана — берётся DATABASE_URL с суффиксом `_test`.
TEST_DATABASE_URL=postgres://dodo:dodo@localhost:5433/dodo_qr_test

# ── Вход в админку (блок auth) ───────────────────────────────
# Учётная запись одна, ролей нет (решение D014). Без этих двух переменных ни один
# экран /admin/* не открывается: вход падает с ошибкой, а не пускает без проверки.

# Хэш пароля единственного администратора, не сам пароль.
# Формат: scrypt$N$r$p$соль$ключ. Посчитать:
#   node scripts/hash-admin-password.mjs        # ввести пароль, затем Ctrl-D
ADMIN_PASSWORD_HASH=

# Секрет подписи сессионной cookie: не короче 32 знаков, свой на каждой площадке.
# Сгенерировать:  openssl rand -base64 48
# Смена секрета разлогинивает всех — это и есть способ отозвать выданные сессии.
SESSION_SECRET=
