# Пример окружения. Скопировать в .env и заполнить значения.
# В git попадает только этот файл — .env в .gitignore, значений в документах нет.

# ── Приложение ───────────────────────────────────────────────
# Порт приложения: http://localhost:3100
PORT=3100

# Публичный адрес продукта — тот, что попадает ВНУТРЬ напечатанного QR-кода станции:
# <адрес>/s/<код станции>. Наклейка печатается один раз и живёт годами, поэтому адрес
# берётся отсюда, а не из кода: на площадке он другой (туннель со своим именем и
# единственным свободным портом), и зашитый localhost сделал бы наклейки мусором.
#
# Не задан — код собирается по адресу, на котором открыта админка. Для разработки
# этого достаточно, на площадке — задайте явно.
#
# ВНИМАНИЕ: значения переменных запекаются в сборку. Смена адреса без пересборки
# продукт не меняет: он продолжит печатать прежний, и это выглядит как «поменяли
# адрес, а коды старые».
PUBLIC_BASE_URL=http://localhost:3100

# Сколько доверенных посредников (обратных прокси) стоит перед продуктом.
# Управляет одним: как считается предел на ОТКРЫТИЕ экрана заполнения по клиенту.
#
# Заголовок `X-Forwarded-For` присылает сам клиент, а посредник лишь дописывает своё
# звено справа. Продукт берёт звено по счёту от конца цепочки — ровно на столько шагов,
# сколько посредников объявлено здесь; всё, что клиент припишет слева, ключа не меняет.
#
# 0 (значение по умолчанию, оно же «переменная не задана») — заголовок не читается вовсе.
# Тогда различить клиентов нечем и предел на открытие экрана НЕ применяется: продукт
# говорит об этом строкой в журнале при старте. Отправка заполнений ограничена
# независимо от этого — по коду станции и по сети целиком.
#
# Ставьте 1 (или больше — по числу посредников) только ПОСЛЕ проверки на площадке:
# надо убедиться, что посредник действительно дописывает адрес клиента в этот заголовок.
# Как проверить — docs/forge/blocks/fill.md, раздел про туннель.
# TRUSTED_PROXY_HOPS=1

# ── База ─────────────────────────────────────────────────────
# Подключение к PostgreSQL из docker-compose.yml
DATABASE_URL=postgres://dodo:dodo@localhost:5433/dodo_qr
# Эти три читает сам docker-compose.yml при подъёме контейнера
POSTGRES_USER=dodo
POSTGRES_PASSWORD=dodo
POSTGRES_DB=dodo_qr
# Порт базы на хосте
DB_PORT=5433
# База для прогона тестов: создаётся сама и пересоздаётся миграциями на каждом прогоне.
# Отдельная от рабочей, чтобы тесты не сносили данные разработчика.
#
# Здесь её НЕ ЗАДАЮТ, и это не забывчивость. Пример копируют в .env все копии репозитория
# сразу, поэтому закреплённое здесь имя снова сделало бы базу общей. Без переменной имя
# считается само: DATABASE_URL с суффиксом `_test_<метка копии>` — своя база у каждой
# копии, без единой настройки (src/blocks/core/repo-copy.ts).
#
# Задавайте TEST_DATABASE_URL, только если тестам нужен ОТДЕЛЬНЫЙ сервер, а не другая
# база на том же: тогда имя выбираете вы и разводить копии тоже придётся вам.
#   TEST_DATABASE_URL=postgres://dodo:dodo@localhost:5435/dodo_qr_test_stand

# ── Вход в админку (блок auth) ───────────────────────────────
# Учётная запись одна, ролей нет (решение D014). Без этих двух переменных ни один
# экран /admin/* не открывается: вход падает с ошибкой, а не пускает без проверки.
#
# ВНИМАНИЕ, знак $ в значениях. Окружение приложения собирает загрузчик .env самого Next:
# он раскрывает `$имя` внутри значений — и в тех, что записаны здесь, и в тех, что пришли
# из окружения снаружи, если их имя упомянуто в этом файле. Делает это молча, без строки
# в логе. Значение со знаком $ доедет до приложения обрезанным: либо обходитесь без $,
# либо экранируйте его как \$. По этой же причине разделитель в хэше пароля — точка,
# а не $ из формата PHC.

# Хэш пароля единственного администратора, не сам пароль. Формат: scrypt.N.r.p.соль.ключ
# Значение ниже — пароль `dodo-local-dev` ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ. Секретом он не является:
# файл лежит в git, и пароль знает всякий, кто видел репозиторий. На площадке
# (NODE_ENV=production) вход с этим значением отказывает — посчитайте своё:
#   node scripts/hash-admin-password.mjs        # ввести пароль, затем Ctrl-D
ADMIN_PASSWORD_HASH=scrypt.32768.8.3.XmUdnCU87hnNNA5iIjXFew.Vhk7VwZ5pnHes93VeQcPkmaoajfjfhP1oTiQdhY7-9Y

# Секрет подписи сессионной cookie: не короче 32 знаков, свой на каждой площадке.
# Значение ниже опубликовано ровно так же и на площадке вход тоже не открывает.
# Сгенерировать своё:  openssl rand -base64 48
# Смена секрета разлогинивает всех — это и есть способ отозвать выданные сессии.
SESSION_SECRET=local-development-only-session-secret-not-a-secret
